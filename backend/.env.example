# ===== DeepSeek V4 API =====
# 获取：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 主力模型：日常 4 阶流水线（快、便宜、并发 2500）
DEEPSEEK_MODEL=deepseek-v4-flash
# 备选模型：复杂推理（如跨片冲突判定），通过 config.get_model("complex") 切换
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# ===== MinerU 文档解析 =====
# pipeline：CPU 可跑，开发推荐
# vlm-engine：需 GPU，生产可选
MINERU_BACKEND=pipeline

# ===== 数据库 =====
# 开发用 SQLite；生产切 PostgreSQL（注释行）
DATABASE_URL=sqlite+aiosqlite:///./data/kbrefiner.db
# DATABASE_URL=postgresql+asyncpg://kbrefiner:kbrefiner@localhost:5432/kbrefiner

# ===== Redis / Celery =====
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== 应用 =====
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== 文件存储 =====
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
MAX_UPLOAD_SIZE_MB=50
