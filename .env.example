# ===== KBRefiner 配置 =====
# 复制本文件为 .env 并填入你自己的 API Key

# ===== LLM API（必填）=====
# 支持所有 OpenAI 兼容的 API：DeepSeek / OpenAI / 本地 Ollama 等

# --- DeepSeek 示例 ---
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_MODEL_PRO=deepseek-v4-pro

# --- OpenAI 示例 ---
# LLM_API_KEY=sk-your-openai-api-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_MODEL_PRO=gpt-4o

# --- 本地 Ollama 示例 ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_MODEL_PRO=qwen2.5:32b

# ===== 文档解析 =====
# auto: 自动检测 MinerU 是否安装，未安装时回退到轻量解析器
# mineru: 强制使用 MinerU（需 pip install mineru）
# simple: 强制使用轻量解析器（pypdf + python-docx）
PARSER_BACKEND=auto

# ===== 应用 =====
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ===== 文件存储 =====
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
MAX_UPLOAD_SIZE_MB=50
